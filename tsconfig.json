{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowJs": false,
        "noEmit": true,
        "types": ["vite/client"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"],
            "@ds": ["resources/js/ds"],
            "@ds/*": ["resources/js/ds/*"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "tests/js/**/*.ts", "tests/js/**/*.tsx", "tests/e2e/**/*.ts", "*.ts"],
    "exclude": ["node_modules", "vendor", "public", "bootstrap/ssr", "resources/js/ds"]
}
