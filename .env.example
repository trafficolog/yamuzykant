APP_NAME="ЯМузыкант"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Витрина дизайн-системы /_ds: по умолчанию включена в local и stage; в production всегда выключена
# DS_SHOWCASE=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Значения совпадают с compose.yaml: `make up` работает без правок этого файла.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ymuzykant
DB_USERNAME=ymuzykant
DB_PASSWORD=ymuzykant

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Трансляция событий (4.1.1): reverb — локально и в CI e2e; в Pest — null (phpunit.xml). Вещатель log выключен.
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Вход по коду на почту: хранилище хэшей кодов и лимитов (store из config/cache.php); в Pest — array
LOGIN_CODE_STORE=redis
# Фиксированный код входа для автотестов. Действует ТОЛЬКО при APP_ENV=testing или e2e, в остальных окружениях игнорируется
# LOGIN_CODE_FAKE=123456

# Вход через Яндекс ID (oauth.yandex.ru). Значения — GitHub Secrets / хранилище окружения, вводит OWNER.
# Адрес возврата по умолчанию — ${APP_URL}/auth/yandex/callback; в кабинете Яндекса указывается тот же.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=http://localhost/auth/yandex/callback
# Подменный Яндекс ID для автотестов (тестовый пользователь без сети). Действует ТОЛЬКО при APP_ENV=testing или e2e
# YANDEX_OAUTH_FAKE=true

# Reverb (4.1.1). Значения ниже — только для local и CI e2e; на stage и в production — хранилище окружения.
# REVERB_HOST/PORT/SCHEME — куда приложение шлёт события; REVERB_SERVER_* — где слушает `php artisan reverb:start`.
REVERB_APP_ID=ymuzykant
REVERB_APP_KEY=ymuzykant-local-key
REVERB_APP_SECRET=ymuzykant-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# Куда подключается браузер (shared prop realtime); по умолчанию — REVERB_HOST/PORT/SCHEME
# REVERB_PUBLIC_HOST=ws.example.ru
# REVERB_PUBLIC_PORT=443
# REVERB_PUBLIC_SCHEME=https
# Хосты страниц, с которых Reverb принимает соединения (через запятую); по умолчанию — хост APP_URL
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=ymuzykant-local-master-key
# Индекс подсказки моделей: `php artisan scout:sync-index-settings` после смены настроек в config/scout.php
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
# SCOUT_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ymuzykant
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Sentry (0.1.5). Без DSN выключено. Релиз = git sha: если не задан, берётся из имени каталога releases/<UTC>-<sha12>.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Токен подробного ответа /health снаружи (заголовок X-Health-Token). Пусто — подробности только с 127.0.0.1.
HEALTH_TOKEN=
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
