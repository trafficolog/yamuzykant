{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build --ssr",
        "lint": "eslint . && prettier --check resources tests vite.config.ts vitest.config.ts playwright.config.ts",
        "typecheck": "tsc --noEmit",
        "test:js": "vitest run",
        "test:e2e": "playwright test --grep-invert @visual",
        "test:visual": "playwright test --grep @visual --pass-with-no-tests",
        "lint:copy": "node tools/lint-copy.mjs",
        "ds:sync": "node tools/ds-sync.mjs",
        "docs:check": "node tools/docs-ops.mjs check",
        "docs:refresh": "node tools/docs-ops.mjs refresh",
        "docs:next": "node tools/docs-ops.mjs next"
    },
    "dependencies": {
        "@inertiajs/react": "^2.3.29",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.64.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^2.1.9",
        "concurrently": "^10.0.6",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "http-server": "^14.1.1",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^1.3.0",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^5.4.21",
        "vitest": "^2.1.9"
    }
}
