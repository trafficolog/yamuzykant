        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, count, showLabel, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|oldPrice|image|icon|condition|rating|reviews|delivery|city|distance|posted|shipping|safe|partner|inspected|rare|favorite|href|action|onMessage|onBuy|cta|ctaLabel|inCart|onQty|key|ref|className|style|children)$/]",
