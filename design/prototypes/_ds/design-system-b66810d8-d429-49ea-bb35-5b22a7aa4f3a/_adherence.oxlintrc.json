        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, suffix, success, loading, demo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='demo'] > Literal[value!=/^(?:focus)$/]",
        "message": "<Field> demo must be one of 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|radio|count|icon|removable|onChange|children|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: selected, disabled, radio, count, icon, removable, onChange, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='FitmentBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:target|status|key|ref|className|style|children)$/]",
        "message": "<FitmentBadge> doesn't accept that prop. Declared props: target, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='FitmentBadge'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:fits|check|no)$/]",
        "message": "<FitmentBadge> status must be one of 'fits' | 'check' | 'no'."
      },
