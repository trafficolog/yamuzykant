{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/commerce/**",
              "components/core/**",
              "components/display/**",
              "components/forms/**",
              "components/service/**",
              "ui_kits/marketplace/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Onest, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|price|fit|image|icon|inCart|href|adding|error|onAdd|key|ref|className|style|children)$/]",
        "message": "<AccessoryCard> doesn't accept that prop. Declared props: title, price, fit, image, icon, inCart, href, adding, error, onAdd."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessoryCard'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:fits|check)$/]",
        "message": "<AccessoryCard> fit must be one of 'fits' | 'check'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessoryRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|groups|key|ref|className|style|children)$/]",
        "message": "<AccessoryRail> doesn't accept that prop. Declared props: title, groups."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|icon|action|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, icon, action, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|danger|service)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warning' | 'danger' | 'service'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|icon|iconRight|href|loading|demo|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, icon, iconRight, href, loading, demo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|outline|muted|ghost|service|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'outline' | 'muted' | 'ghost' | 'service' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|s|m|l)$/]",
        "message": "<Button> size must be one of 'xs' | 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='demo'] > Literal[value!=/^(?:hover|focus|active)$/]",
        "message": "<Button> demo must be one of 'hover' | 'focus' | 'active'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatalogSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|counts|hrefs|onChange|key|ref|className|style|children)$/]",
        "message": "<CatalogSwitch> doesn't accept that prop. Declared props: value, counts, hrefs, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatalogSwitch'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:catalog|flea)$/]",
        "message": "<CatalogSwitch> value must be one of 'catalog' | 'flea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|indeterminate|onChange|demo|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, hint, error, indeterminate, onChange, demo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute[name.name='demo'] > Literal[value!=/^(?:hover|focus)$/]",
        "message": "<Checkbox> demo must be one of 'hover' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConditionBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:condition|key|ref|className|style|children)$/]",
        "message": "<ConditionBadge> doesn't accept that prop. Declared props: condition."
      },
      {
        "selector": "JSXOpeningElement[name.name='FavoriteButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|count|onToggle|key|ref|className|style|children)$/]",
        "message": "<FavoriteButton> doesn't accept that prop. Declared props: active, count, onToggle."
      },
